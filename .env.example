# Modèle de réponse : gemini (défaut, gratuit), deepseek ou anthropic
LLM_PROVIDER=gemini
# Facultatif. gemini : gemini-3.8-flash (défaut). deepseek : deepseek-v4-pro (défaut) ou deepseek-flash. anthropic : claude-opus-5-5 (défaut)
LLM_MODEL=
# Facultatif. gemini : low|medium|high (medium). deepseek : low|high|max (high). anthropic : low|medium|high|xhigh|max (medium)
LLM_EFFORT=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
HF_TOKEN=
